@page "/"
<PageTitle>ChargeFlow · Decision Explorer</PageTitle>
<a class="skip-link" href="#workspace">Skip to workspace</a>
<header class="topbar"><a class="brand" href="/"><span class="brand-symbol">↗</span><span>ChargeFlow <small>INTELLIGENCE LAB</small></span></a><span class="lab-badge">CFIL–06 • RESEARCH OBSERVATORY</span><span class="local-badge">Local · read only</span></header>
<div class="app-shell" inert="@(!interactive)" data-interactive="@interactive.ToString().ToLowerInvariant()"><aside class="sidebar"><p class="eyebrow">EXPLORE THE EVIDENCE</p><nav aria-label="Main navigation">
@for(var i=0;i<sections.Length;i++){var name=sections[i];<button class="nav-item @(section==name?"active":"")" aria-current="@(section==name?"page":null)" @onclick="()=>Tab(name)"><span>0@(i+1)</span>@name</button>}
</nav><div class="sidebar-note"><span class="badge">SYNTHETIC</span><p>Real simulation records.<br />Traceable decisions.<br />No new policy execution.</p><small>EUR net · research scenarios<br />CFIL06-READ-V1</small></div></aside>
<main id="workspace"><div class="page-heading"><div><p class="eyebrow">OBSERVE. INVESTIGATE. RECONCILE.</p><h1>@section</h1></div><span class="badge">@(Current?.Policy??"—") / @(Current?.Status??"No run")</span></div>
<div id="connection-status" role="status" class="connection" hidden>Connection interrupted. Display frozen; a full snapshot will be requested on reconnect.</div>
@if(error.Length>0){<div class="alert" role="alert">@error</div>}
@if(busy){<div class="loading" role="status">Reading a consistent source snapshot…</div>}
@if(section=="Runs")
{
    <section class="hero"><div><span class="eyebrow">FROM TRAFFIC TO A DECISION</span><h2>Follow the truck.<br /><em>Understand the trade-off.</em></h2><p>Explore recorded traffic, charging constraints and economic decisions — at the moment they were made.</p></div><div class="hero-stat"><strong>24 h</strong><span>simulation horizon</span><strong>50 + 1,000</strong><span>trucks + passenger cars · baseline</span></div></section>
    <div class="section-heading"><h2>Approved run catalog</h2><button @onclick="()=>runs=Observer.Catalog.List()">Refresh catalog</button></div><p class="muted">Accepted archives, development cases and observer controls are separate. Missing evidence is never substituted.</p>
    <div class="run-grid">@foreach(var run in runs){<article class="run-card"><div class="eyebrow">@run.Group</div><h3>@run.Name</h3><p><span class="badge">@run.Status</span> <span class="badge">@run.Origin</span></p><dl class="compact"><dt>Population</dt><dd>@(run.Status is "missing" or "invalid"?"N/A":$"{run.Trucks} trucks / {run.Cars} cars")</dd><dt>Scenario</dt><dd>@run.Scenario</dd><dt>Model</dt><dd>@run.ModelVersion</dd><dt>Economics</dt><dd>@run.EconomicsMode</dd></dl><details><summary>Provenance &amp; availability</summary><p>@run.Integrity</p><p class="mono">Run: @run.RunId<br />Code: @run.CodeHash</p><p>Available: @string.Join(", ",run.Artifacts)</p><p>Missing: @(run.Missing.Length==0?"None":string.Join(", ",run.Missing))</p></details><button class="primary" disabled="@(run.Status is "missing" or "invalid"||run.Integrity=="CHECKSUM_MISMATCH")" @onclick="()=>OpenRun(run.Key)">Open @run.Key</button></article>}</div>
}
else
{
    <section class="transport" aria-label="Replay controls">
    <label>Run<select aria-label="Selected run" value="@runKey" @onchange="e=>OpenRun(e.Value!.ToString()!)">@foreach(var run in runs){<option value="@run.Key">@run.Name</option>}</select></label>
    <div class="transport-buttons"><button @onclick="()=>playing=true" disabled="@(scene is null||live)" aria-label="Play replay">▶ Play</button><button @onclick="Pause">Ⅱ Pause view</button><button @onclick="Next" disabled="@(scene is null)">Next event</button><button @onclick="GoLive">Go live</button></div>
    <label>Speed<select @bind="speed" aria-label="Replay speed"><option value="1">1×</option><option value="60">60×</option><option value="300">300×</option><option value="1800">1,800×</option></select></label>
    <label class="seek">Simulation time <strong data-testid="cursor">@Time(cursor)</strong><input type="range" aria-label="Simulation time" min="0" max="@((scene?.ProducerTimeMs??Current?.DurationMs??86400000)/1000)" step="1" value="@(cursor/1000)" @onchange="Seek" /></label>
    <label class="check"><input type="checkbox" checked="@hindsight" @onchange="HindsightChanged" /> Explicit hindsight</label></section>
    @if(hindsight){<div class="notice">HINDSIGHT OPEN · Later observed results may be shown. They were unavailable at the historical decision time.</div>}
    @if(scene is not null)
    {
        <div class="freshness" data-testid="freshness"><strong>@(live?scene.Health=="LIVE_DELAYED"?"LIVE · DELAYED":"LIVE":"REPLAY")</strong><span>Published time @Time(scene.ProducerTimeMs)</span><span>Telemetry @Time(scene.DisplayedTimeMs)</span><span>Received @scene.ReceivedUtc.ToString("HH:mm:ss 'UTC'")</span><span>#@scene.SourceSequence · generation @scene.Generation</span><span>@scene.Delivery</span></div>
        @if(section=="Live / Replay")
        {
            <section class="map-card"><div class="section-heading"><h2>Recorded corridor</h2><span class="legend"><i class="truck"></i> Truck <i class="car"></i> Car <i class="park"></i> Charging park → Travel direction</span></div><canvas id="traffic-map" aria-label="Recorded traffic map. Use tables below for keyboard selection." role="img"></canvas><p class="map-caption">Actual SUMO edge geometry · vertical scale exaggerated · front-anchored symbols · exact lane unavailable · positions held between 5-minute observations · no interpolation</p></section>
            <div class="count-strip">@foreach(var count in scene.Counts){<div><strong>@count.Value</strong><span>@count.Key</span></div>}</div>
            <div class="section-heading"><h2>Charging parks</h2><span>Physical bays ≠ electrical capacity ≠ queue capacity</span></div>
            <div class="park-grid">@foreach(var park in scene.Parks){<button class="park-card @(parkId==park.Id?"selected":"")" @onclick="()=>SelectPark(park.Id)"><strong>@park.Id</strong><span>@park.Bays.Count(b=>b.Occupant is not null) / @park.Bays.Length bays occupied</span><span>@park.Queue.Length / @park.QueueCapacity queued</span><span>@Number(park.AvailableGridKw," kW") available</span></button>}</div>
            @if(scene.Parks.FirstOrDefault(p=>p.Id==parkId) is {} parkDetail)
            {<section class="panel"><h2>@parkDetail.Id · park investigation</h2><div class="metric-grid"><div><span>Grid configured / available</span><strong>@Number(parkDetail.ConfiguredGridKw) / @Number(parkDetail.AvailableGridKw) kW</strong></div><div><span>Assigned / metered interval mean</span><strong>@Number(parkDetail.AssignedPowerKw) / @Number(parkDetail.ObservedMeanGridKw) kW</strong></div><div><span>Access width</span><strong>@parkDetail.AccessWidthM m</strong></div></div><p class="muted">@parkDetail.PowerMeaning</p><p>Queue: @string.Join(", ",parkDetail.Queue) · inbound: @parkDetail.Inbound.Length · planning intents: @parkDetail.Intents.Length (soft intentions, no reservation)</p><div class="table-wrap"><table><caption>Physical bays and electrical connector limits</caption><thead><tr><th>Bay</th><th>Occupant</th><th>Geometry</th><th>Turning / trailer</th><th>Drive through</th><th>Connector</th><th>Conflicts / exit blockers</th></tr></thead><tbody>@foreach(var bay in parkDetail.Bays){<tr><th>@bay.Id @(bay.Blocked?"BLOCKED":"")</th><td>@(bay.Occupant??"Free")</td><td>@bay.LengthM × @bay.WidthM m</td><td>@bay.TurningRadiusM / @bay.TrailerM m</td><td>@bay.DriveThrough</td><td>@bay.Connector · @bay.ConnectorLimitKw kW</td><td>@string.Join(", ",bay.Conflicts) / @string.Join(", ",bay.ExitBlockedBy)</td></tr>}</tbody></table></div><details><summary>Published synthetic tariffs at cursor (@tariffs.Length)</summary>@foreach(var tariff in tariffs){<Facts Value="tariff" />}</details></section>}
            <section class="panel"><div class="section-heading"><h2>Vehicle table · map alternative</h2><div class="filters"><label>Class<select @bind="kind"><option>Truck</option><option>Car</option><option>All</option></select></label><label>Vehicle ID<input @bind="filter" @bind:event="oninput" placeholder="Search vehicle" /></label></div></div><div class="table-wrap vehicle-table"><table><thead><tr><th>Vehicle</th><th>State</th><th>SoC</th><th>Distance</th><th>Park / bay</th><th>Position observed</th></tr></thead><tbody>@foreach(var v in VisibleVehicles){<tr><th><button class="text-button" @onclick="()=>SelectVehicle(v.Id)">@v.Id</button></th><td><span class="status">@v.Status</span></td><td>@Number(v.Soc*100,"%")</td><td>@Number(v.DistanceM/1000," km")</td><td>@(v.ParkId??"—") / @(v.BayId??"—")</td><td>@Time(v.PositionTimeMs) @(v.Stale?"· STALE":"")</td></tr>}</tbody></table></div></section>
        }
        else if(section=="Vehicle & Decisions" && vehicle is not null)
        {
            <section class="panel"><div class="section-heading"><h2 data-testid="selected-vehicle">@vehicle.Current.Id · Vehicle 360°</h2><button @onclick='()=>Tab("Economics")'>Open vehicle economics →</button></div><div class="metric-grid"><div><span>Observed state</span><strong>@vehicle.Current.Status</strong></div><div><span>Battery</span><strong>@Number(vehicle.Current.Soc*100,"%") · @Number(vehicle.Current.EnergyKwh," kWh")</strong></div><div><span>Distance</span><strong>@Number(vehicle.Current.DistanceM/1000," km")</strong></div><div><span>Park / bay</span><strong>@(vehicle.Current.ParkId??"—") / @(vehicle.Current.BayId??"—")</strong></div></div><details><summary>Vehicle constraints and archived route</summary><Facts Value="JsonSerializer.SerializeToElement(vehicle.Definition,J.Options)" /><p class="mono">Route: @(vehicle.CurrentRoute.Length==0?"N/A — no applied route recorded by cursor":string.Join(" → ",vehicle.CurrentRoute))</p></details>@foreach(var gap in vehicle.DataGaps){<p class="muted small">@gap</p>}</section>
            <h2>Decisions available by @Time(cursor)</h2>@if(vehicle.Decisions.Length==0){<p class="notice">No decision was available at this time.</p>}@foreach(var decision in vehicle.Decisions){<DecisionCard Item="decision" />}
            <section class="panel"><h2>Trip &amp; charging timeline</h2><div class="table-wrap"><table><thead><tr><th>Time</th><th>Event</th><th>Source</th><th>Observed facts</th></tr></thead><tbody>@foreach(var e in vehicle.Events){<tr><td><button class="text-button" @onclick="()=>SeekTo(e.TimeMs)">@Time(e.TimeMs)</button></td><td>@e.Type</td><td>#@e.Sequence</td><td><details><summary>Event details</summary><Facts Value="e.Facts" /></details></td></tr>}</tbody></table></div></section>
        }
        else if(section=="Economics" && costs is not null)
        {
            <section class="panel"><p class="eyebrow">EUR NET · SYNTHETIC · SELECTED VEHICLE ONLY</p><h2>@vehicleId · Cost reconciliation</h2><p class="notice">@costs.Availability</p><p>@costs.Denominator</p><h3>1 · Estimate at decision time</h3><p class="muted">A quote or recommendation is not a provider invoice.</p>@foreach(var decision in vehicle?.Decisions??[]){@if(decision.Economics is {} econ){<details><summary>@Time(decision.TimeMs) · @decision.SelectedPark · recorded estimate</summary><Facts Value="econ" /></details>}}
            @if(vehicle?.Decisions.Any(d=>d.Economics is not null)!=true){<p>N/A — no economic estimate recorded by this cursor.</p>}<h3>2 · Provider bills &amp; session lifecycle</h3>@if(costs.Sessions.Length==0){<p>N/A — no committed session amounts available in this view.</p>}@foreach(var session in costs.Sessions){<article class="session"><h4>Session @session.Get("observation")?.Text("sessionId") · @session.Text("status")</h4><Facts Value="session" /></article>}
            <h3>3 · Internal economic assessment</h3><p class="muted">Time, lateness, failure and inventory valuation are internal costs. Battery inventory adjustment is not a provider refund.</p>@if(costs.VehicleAssessment is {} assessment){<Facts Value="assessment" />}else{<p>N/A — no final vehicle assessment available at this cursor.</p>}<details><summary>Quote → binding → bill reconciliation</summary>@foreach(var row in costs.Reconciliations){<Facts Value="row" />}</details>@foreach(var note in costs.Notes){<p class="muted small">@note</p>}<p class="source">Source: @costs.Source.Artifact · sequence @costs.Source.Sequence</p></section>
        }
        else if(section=="Compare & Learning")
        {
            <section class="panel"><div class="section-heading"><h2>Paired-run investigation</h2><div><button @onclick='()=>Example(714,"e0")'>Explore 714 · adverse trade-off</button><button @onclick='()=>Example(715,"e1")'>Explore 715 · E2/E1 benefit</button></div></div><p>Left: <strong>@Current?.Name</strong></p><label>Right run<select value="@rightKey" @onchange="RightChanged" aria-label="Right comparison run">@foreach(var run in runs){<option value="@run.Key">@run.Name</option>}</select></label><button class="primary" @onclick="Compare">Compare runs</button>
            @if(comparison is not null)
            {
                @if(!comparison.Comparable){<div class="alert" role="alert">NOT COMPARABLE · @string.Join("; ",comparison.Reasons). No paired difference is displayed.</div>}
                else
                {
                    <p class="notice">@comparison.SubsetNotice</p><p><strong>@comparison.Denominator</strong></p><div class="table-wrap"><table data-testid="comparison-money"><caption>Observed monetary differences · left minus right</caption><thead><tr><th>Metric</th><th>EUR net / paired run</th></tr></thead><tbody>@foreach(var delta in comparison.MoneyDifferences){<tr><th>@Facts.Label(delta.Key)</th><td class="money">@Money(delta.Value)</td></tr>}</tbody></table></div>@if(comparison.MoneyDifferences.Count==0){<p>N/A — final economic reports unavailable.</p>}
                    <div class="count-strip">@foreach(var delta in comparison.OperationalDifferences){<div><strong>@delta.Value.ToString("+0;-0;0")</strong><span>@delta.Key · trucks / paired run</span></div>}</div><p>First documented lifecycle difference: @(comparison.FirstLifecycleDifferenceMs is {} difference?Time(difference):"N/A"). @comparison.DifferenceScope</p>
                    <label>Coupled vehicle<select value="@vehicleId" @onchange="async e=>{vehicleId=e.Value!.ToString()!;generation++;await LoadAsync();}">@foreach(var v in scene.Vehicles.Where(v=>v.Kind=="Truck")){<option>@v.Id</option>}</select></label><div class="paired">@foreach(var side in new[]{vehicle,rightVehicle}){@if(side is not null){<article class="candidate"><p class="eyebrow">@side.RunKey · @Time(side.CursorMs)</p><h3>@side.Current.Id · @side.Current.Status</h3><p>@Number(side.Current.Soc*100,"% SoC") · @Number(side.Current.DistanceM/1000," km") · @(side.Current.ParkId??"No park")</p><p>Recorded park choices: @string.Join(" → ",side.Decisions.Select(d=>d.SelectedPark))</p><p>Events: @side.Events.Length · observed through common cursor</p><details><summary>Selected vehicle economic assessment</summary>@if((ReferenceEquals(side,vehicle)?costs:rightCosts)?.VehicleAssessment is {} pairedCost){<Facts Value="pairedCost" />}else{<p>N/A — final assessment unavailable at cursor.</p>}</details><details><summary>Decision and outcome timeline</summary>@foreach(var decision in side.Decisions){<DecisionCard Item="decision" />}</details></article>}}</div>
                }
                @if(comparison.FormalQuality is {} quality){<section class="formal"><h3>Formal accepted quality · all five evaluation seeds</h3><p>Engineering PASS is separate from operational and economic benefit. The selected seed does not replace this fixed verdict. Synthetic evidence; no claim of statistical significance.</p><FormalQuality Value="quality" /></section>}
            }
            </section>
            @if(learning is not null)
            {
                @if(learning.MultiDay is {} multiDay)
                {
                    <section class="panel" data-testid="multiday-learning"><h2>Multi-day learning timeline</h2>
                    <p>@multiDay.Text("interpretation")</p>
                    <div class="table-wrap"><table><thead><tr><th>Operating day</th><th>Resolved truck labels</th><th>MAE (seconds)</th><th>Model revision</th><th>Arrivals / stranded</th><th>Car error</th></tr></thead><tbody>
                    @foreach(var day in multiDay.GetProperty("days").Items())
                    {<tr><th>Day @day.Long("day")</th><td>@day.Long("labels")</td><td>@(day.Get("maeSeconds") is {ValueKind:JsonValueKind.Number} mae?mae.GetDouble().ToString("0.0"):"N/A")</td><td>@(day.Get("revision") is {ValueKind:JsonValueKind.Number} revision?revision.ToString():"N/A")</td><td>@day.Long("arrived") / @day.Long("stranded")</td><td>N/A · 0 labels</td></tr>}
                    </tbody></table></div>
                    <details><summary>Observed operating phases and capacity changes</summary>
                    @foreach(var change in multiDay.GetProperty("operatingChanges").Items())
                    {<p>@Time(change.Long("timeMs")) · @change.Text("park") · @change.Num("availableGridKw") kW available</p>}
                    </details>
                    <h3>Recorded adaptation events</h3>
                    @if(multiDay.GetProperty("transitions").GetArrayLength()==0){<p>No alarm, challenger comparison or promotion available by this cursor.</p>}
                    @foreach(var transition in multiDay.GetProperty("transitions").Items())
                    {<details><summary>@Time(transition.Long("timeMs")) · @transition.Text("type")</summary><Facts Value="transition" /></details>}
                    </section>
                }
                <section class="panel"><h2>Learning &amp; delayed evaluation</h2><div class="metric-grid"><div><span>Policy</span><strong>@learning.Policy @(learning.Frozen?"· FROZEN CHECKPOINT":"")</strong></div><div><span>Online updates</span><strong>@(learning.OnlineUpdates?.ToString()??"N/A")</strong></div><div><span>Truck labels / car labels</span><strong>@learning.TruckLabels / @learning.CarLabels</strong></div><div><span>Model revision</span><strong>@(learning.CurrentRevision?.ToString()??"N/A")</strong></div></div><p>@learning.MetricAvailability</p><p>Passenger-car error: N/A · 0 labels. Drift: @learning.Drift</p>@if(learning.Metrics is {} metrics){<details><summary>Recorded provider metrics</summary><Facts Value="metrics" /></details>}<div class="table-wrap"><table><thead><tr><th>Truck</th><th>Prediction time</th><th>Revision / method</th><th>Forecast</th><th>Label available</th><th>Observed label</th></tr></thead><tbody>@foreach(var row in learning.Rows){<tr><th>@row.VehicleId</th><td>@Time(row.PredictionTimeMs)</td><td>@row.Revision / @row.Method</td><td>@Number(row.PredictionSeconds," s")</td><td>@(row.LabelAvailableMs is {} available?Time(available):"PENDING")</td><td>@Number(row.LabelSeconds," s") · @row.Status</td></tr>}</tbody></table></div>@foreach(var note in learning.Notes){<p class="muted small">@note</p>}</section>
            }
        }
        <footer class="evidence-footer">@scene.RunId · @scene.ProjectionVersion · Source @scene.Source.Artifact #@scene.Source.Sequence<br />@string.Join(" ",scene.Gaps)</footer>
    }
    else if(!busy){<section class="empty"><h2>Choose a recorded run</h2><p>Open a source from Runs to start your investigation.</p><button @onclick='()=>Tab("Runs")'>Browse catalog</button></section>}
}
</main></div>
